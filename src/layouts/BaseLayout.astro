---
import "../styles/global.css";
import "@fontsource/manrope/latin-400.css";
import "@fontsource/manrope/latin-500.css";
import "@fontsource/manrope/latin-600.css";
import "@fontsource/manrope/latin-700.css";
import "@fontsource/manrope/latin-800.css";
import "@fontsource/fraunces/latin-400.css";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import "@fontsource/fraunces/latin-700.css";
import "@fontsource/fraunces/latin-400-italic.css";
import "@fontsource/fraunces/latin-500-italic.css";
import "@fontsource/fraunces/latin-600-italic.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const { title, description, ogImage, ogType = "website", noindex = false } = Astro.props;

const siteName = "Hubei Province Travel Guide";
const fullTitle = title.includes(siteName) ? title : `${siteName} | ${title}`;
const canonicalURL =
  Astro.url.pathname === "/"
    ? new URL("/", Astro.site).href.replace(/\/$/, "")
    : new URL(Astro.url.pathname, Astro.site).href;
const robotsContent = noindex ? "noindex, follow" : "index, follow";

const defaultOgImage = new URL("/images/og-hubei.webp", Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : defaultOgImage;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.hubei-province.com/#organization",
  name: "Hubei Province Travel Guide",
  url: "https://www.hubei-province.com",
  description:
    "Independent travel guide to Hubei Province, China. Discover Wuhan's Yellow Crane Tower, the Taoist Wudang Mountains, Shennongjia's primeval forest, the Three Gorges Dam, Enshi Grand Canyon, hot dry noodles and Three Kingdoms history.",
  logo: "https://www.hubei-province.com/favicon.svg",
  foundingDate: "2026",
  sameAs: ["https://github.com/jiusongvip/hubei-province"],
  knowledgeAbout: [
    { "@type": "Thing", name: "Hubei Province" },
    { "@type": "Thing", name: "Wuhan" },
    { "@type": "Thing", name: "Wudang Mountains" },
    { "@type": "Thing", name: "Three Gorges" },
    { "@type": "Thing", name: "Shennongjia" },
    { "@type": "Thing", name: "Enshi Grand Canyon" },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <slot name="head" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S0ZTMPTCQV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-S0ZTMPTCQV');
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!noindex && <link rel="alternate" hreflang="en" href={canonicalURL} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonicalURL} />}

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
  </head>
  <body>
    <div class="loading-veil" id="loading-veil" aria-hidden="true">
      <div>
        <div class="loading-mark mx-auto">鄂</div>
        <p class="loading-word">Hubei Province Travel Guide</p>
      </div>
    </div>
    <script is:inline>
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var veil = document.getElementById("loading-veil");
        if (!veil) return;
        if (reduce) { veil.classList.add("done"); return; }
        requestAnimationFrame(function () { setTimeout(function () { veil.classList.add("done"); }, 120); });
        window.addEventListener("load", function () { setTimeout(function () { veil.classList.add("done"); }, 100); });
      })();
    </script>

    <div id="reading-progress" style="position:fixed;top:0;left:0;height:2px;background:#b8432b;z-index:9999;width:0%;transition:width 0.1s linear;"></div>
    <button id="back-to-top" style="position:fixed;bottom:24px;right:24px;width:46px;height:46px;border-radius:50%;background:rgba(251,248,242,0.92);border:1px solid #e6ddcb;box-shadow:0 4px 18px rgba(26,23,18,0.12);cursor:pointer;z-index:9998;display:none;align-items:center;justify-content:center;transition:all 0.3s ease;" aria-label="Back to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b8432b" stroke-width="1.6" stroke-linecap="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <slot />
  </body>
</html>

<script is:inline>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    var bar = document.getElementById("reading-progress");
    var btn = document.getElementById("back-to-top");
    var onScroll = function () {
      var h = document.documentElement;
      var pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
      if (bar) bar.style.width = Math.min(pct, 100) + "%";
      if (btn) btn.style.display = window.scrollY > 600 ? "flex" : "none";
    };
    window.addEventListener("scroll", onScroll, { passive: true });

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) entry.target.classList.add("reveal-in");
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll(".reveal").forEach(function (el) { observer.observe(el); });

    document.querySelectorAll(".faq-item button").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var parent = btn.parentElement;
        if (parent) parent.classList.toggle("open");
      });
    });

    var nav = document.getElementById("main-nav");
    if (nav) {
      var onNavScroll = function () { nav.classList.toggle("nav-solid", window.scrollY > 60); };
      onNavScroll();
      window.addEventListener("scroll", onNavScroll, { passive: true });
    }

    var menuBtn = document.getElementById("mobile-menu-btn");
    var mobileMenu = document.getElementById("mobile-menu");
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener("click", function () { mobileMenu.classList.toggle("hidden"); });
      mobileMenu.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", function () { mobileMenu.classList.add("hidden"); });
      });
    }
  })();
</script>

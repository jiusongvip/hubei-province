---
---
<section class="hero-stage">
  <div class="hero-grid">
    <!-- Left: copy -->
    <div class="hero-copy">
      <p class="kicker">Hubei · 湖北 (hoo-bay) · Central China · 2026</p>
      <h1 id="hero-title" class="hero-title text-5xl md:text-6xl lg:text-7xl">
        Hubei, <em>Beyond</em> Wuhan
      </h1>
      <p class="hero-sub text-base md:text-lg leading-relaxed">
        The 7-day verdict: yes. Fly into Wuhan, then run
        <span class="font-semibold text-stone-900">Wuhan → Wudang → the Three Gorges</span>
        on one high-speed-rail line.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#matcher" class="btn btn-primary">Find your direction</a>
        <a href="#itineraries" class="btn btn-outline">See the 7-day route</a>
      </div>

      <p class="hero-meta">
        <span>By Wei Chen</span>
        <span aria-hidden="true">·</span>
        <span>Updated August 2026</span>
        <span aria-hidden="true">·</span>
        <span>Firsthand trips across the province</span>
      </p>
    </div>

    <!-- Right: framed photograph with a red seal -->
    <div class="hero-photo">
      <figure class="hero-frame">
        <img
          src="/images/hubei-hero.webp"
          alt="Qutang Gorge on the Yangtze, seen from Baidicheng in Hubei"
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <span class="hero-seal" aria-hidden="true">鄂</span>
      </figure>
      <figcaption class="hero-caption">
        <span>The Yangtze at Qutang Gorge</span>
        <span>长江 · 瞿塘峡</span>
      </figcaption>
    </div>
  </div>
</section>

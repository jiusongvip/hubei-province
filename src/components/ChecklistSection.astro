---
const groups = [
  {
    title: "Before you book",
    items: [
      "Confirm your visa: China offers visa-free entry to 76 countries and a 240-hour transit visa-free policy for 55 countries, including via Wuhan. Check your nationality first.",
      "Book the Three Gorges cruise (CNY 800-1,500+) well ahead for autumn, and reserve a night on Wudang or near Dajiu Lake if you want sunrise.",
      "Arrange a private driver for Shennongjia and the Enshi canyon — public transport is thin, and drivers book out in October.",
    ],
  },
  {
    title: "Before you fly",
    items: [
      "Set up Alipay or WeChat Pay and link a card. Mobile payment is standard everywhere.",
      "Download an offline translation app (Google Translate offline or Pleco) and save screenshots of addresses and dish names.",
      "Carry some cash for rural Enshi and Shennongjia, where card readers are rare.",
    ],
  },
  {
    title: "On the road",
    items: [
      "Pack grippy shoes for Wudang's temple stairs and Enshi's canyon paths, plus rain gear for spring and summer.",
      "Bring sunscreen and a hat for Wuhan's summer 'furnace', and hydrate — avoid midday sightseeing in July and August.",
      "Keep your passport handy for rail boarding and hotel check-in, which require it.",
    ],
  },
];
---
<section id="checklist" class="py-20 md:py-28 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        The pre-trip checklist
      </h2>
      <p class="text-stone-500 text-lg mt-4 leading-relaxed max-w-2xl">
        Nine things that prevent most first-trip hiccups. Tick them off and the rest is scenery.
      </p>
    </div>

    <div class="space-y-8">
      {groups.map((g) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-brand-700 mb-4">{g.title}</h3>
          <ul class="space-y-3">
            {g.items.map((it) => (
              <li class="flex gap-3 items-start">
                <input type="checkbox" class="mt-1 w-4 h-4 accent-brand-700 shrink-0" />
                <span class="text-stone-700 text-sm md:text-base leading-relaxed">{it}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

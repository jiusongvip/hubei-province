---
const layers = [
  { era: "8th–3rd c. BC", name: "Chu culture", chinese: "楚文化", body: "The 800-year Chu kingdom left the bronze chime bells of Marquis Yi of Zeng, the Sword of Goujian, lacquerware and the Chu Ci. The Hubei and Jingzhou museums hold the greatest of it." },
  { era: "208–221 AD", name: "The Three Kingdoms", chinese: "三国", body: "More than 70 of the Romance's 120 chapters unfold here: the Red Cliffs, Jingzhou's walls, Xiangyang's Longzhong and the cult of Guan Yu." },
  { era: "Tang–Ming", name: "Taoist Wudang", chinese: "武当道教", body: "A Taoist center since the Tang, crowned by the Ming emperor's 300,000 workers. The cradle of tai chi and internal martial arts." },
  { era: "1911–1957", name: "Modern Wuhan", chinese: "武汉近现代", body: "The 1911 Wuchang Uprising ended the imperial era, and the 1957 Yangtze River Bridge made the modern nation. Revolution and dynasty side by side." },
];

const festivals = [
  { name: "Dragon Boat Festival", chinese: "端午节", when: "5th lunar month", what: "Honors the poet Qu Yuan from Zigui, with dragon-boat races and zongzi." },
  { name: "Cherry blossom season", chinese: "樱花季", when: "Late March", what: "Wuhan University and East Lake burst into bloom." },
  { name: "Wudang martial arts", chinese: "武当武术节", when: "Varies", what: "Taoist kung fu and tai chi performances on the mountain." },
  { name: "Tujia Nuer Hui", chinese: "土家女儿会", when: "Lunar July", what: "Enshi's Tujia gathering of song and courtship rituals." },
];
---
<section id="culture" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        Four layers of history
      </h2>
      <p class="text-stone-500 text-lg mt-4 leading-relaxed max-w-2xl">
        Chu rose here, the Three Kingdoms turned here, and modern China began here. Read it as a timeline.
      </p>
    </div>

    <div class="relative">
      <div class="absolute top-6 left-6 right-6 h-px bg-gradient-to-r from-brand-200 via-brand-500 to-stone-300 hidden lg:block" aria-hidden="true"></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {layers.map((c) => (
          <div class="relative">
            <div class="flex items-center gap-3 mb-4 relative z-10">
              <span class="w-3 h-3 rounded-full bg-brand-700 ring-4 ring-brand-100"></span>
              <span class="text-xs font-semibold text-brand-700 uppercase tracking-wider">{c.era}</span>
            </div>
            <div class="bg-stone-50 rounded-2xl border border-stone-200 p-6">
              <h3 class="text-lg font-bold text-stone-900">{c.name} <span class="text-stone-400 font-medium text-sm">{c.chinese}</span></h3>
              <p class="text-sm text-stone-600 mt-2 leading-relaxed">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <details class="bg-stone-50 rounded-2xl border border-stone-200 overflow-hidden group">
      <summary class="cursor-pointer flex items-center justify-between px-7 py-5 text-lg font-bold text-stone-900 list-none">
        Festivals worth timing your trip around
        <svg class="w-5 h-5 text-stone-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div class="px-7 pb-7">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[560px] text-left text-sm">
            <thead>
              <tr class="border-b border-stone-200">
                <th class="py-3 pr-4 font-semibold text-stone-900">Festival</th>
                <th class="py-3 pr-4 font-semibold text-stone-900">When</th>
                <th class="py-3 font-semibold text-stone-900">What happens</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              {festivals.map((f) => (
                <tr>
                  <td class="py-3 pr-4 text-stone-700 font-medium whitespace-nowrap">{f.name} <span class="text-stone-400">{f.chinese}</span></td>
                  <td class="py-3 pr-4 text-stone-600 whitespace-nowrap">{f.when}</td>
                  <td class="py-3 text-stone-600">{f.what}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </details>
  </div>
</section>

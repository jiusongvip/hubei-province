---
import { destinations } from "../data/destinations";

const groups = [
  { dir: "East · Wuhan & the heartland", note: "The capital, the breakfast ritual and the Red Cliffs", slugs: ["wuhan", "chibi"] },
  { dir: "Northwest · Wudang & Xiangyang", note: "Taoist peaks and the Three Kingdoms' Longzhong", slugs: ["wudang-mountains", "xiangyang"] },
  { dir: "West · The Yangtze spine", note: "The dam, the gorges and the forest", slugs: ["yichang-three-gorges", "shennongjia", "jingzhou-ancient-city"] },
  { dir: "Southwest · Enshi", note: "The Colorado-style canyon and Tujia culture", slugs: ["enshi-grand-canyon"] },
];

const bySlug = Object.fromEntries(destinations.map((d) => [d.slug, d]));
---
<section id="destinations" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-14">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        Eight places worth planning around
      </h2>
      <p class="text-stone-500 text-lg mt-4 leading-relaxed max-w-2xl">
        Grouped by direction from Wuhan, west to east along the Yangtze. Each card tells you how long to stay and who it is for.
      </p>
    </div>

    <div class="space-y-14">
      {groups.map((g) => (
        <div>
          <div class="flex items-baseline gap-3 mb-6">
            <span class="w-2 h-2 rounded-full bg-brand-700"></span>
            <h3 class="text-xl font-bold text-stone-900">{g.dir}</h3>
          </div>
          <p class="text-sm text-stone-500 -mt-3 mb-6 ml-5">{g.note}</p>

          <div class="space-y-6">
            {g.slugs.map((slug) => {
              const d = bySlug[slug];
              return (
                <article class="dest-card grid grid-cols-1 lg:grid-cols-12 bg-stone-50 rounded-2xl border border-stone-200 overflow-hidden">
                  <div class="lg:col-span-5 relative overflow-hidden aspect-[16/10] lg:aspect-[4/3] lg:self-start">
                    <img src={d.image} alt={`${d.name} ${d.chinese}, Hubei`} class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
                    <div class="absolute top-4 left-4 px-3 py-1 bg-brand-700/90 text-white text-xs font-semibold rounded-full">{d.minDays}</div>
                  </div>
                  <div class="lg:col-span-7 p-6 md:p-8 flex flex-col">
                    <div class="flex items-baseline justify-between gap-3">
                      <h4 class="text-xl md:text-2xl font-bold text-stone-900">{d.name} <span class="text-stone-400 font-medium text-base">{d.chinese}</span></h4>
                    </div>
                    <p class="text-sm text-stone-400 mt-0.5">{d.region}</p>
                    <p class="text-brand-700 font-medium mt-3">{d.tagline}</p>
                    <p class="text-stone-600 text-sm mt-3 leading-relaxed">{d.overview}</p>

                    <div class="mt-4 flex flex-wrap gap-2">
                      {d.highlights.slice(0, 4).map((h) => (
                        <span class="px-2.5 py-1 bg-white border border-stone-200 text-stone-600 text-xs rounded-full">{h}</span>
                      ))}
                    </div>

                    <div class="mt-4 bg-white rounded-xl border border-stone-200 p-4">
                      <p class="text-sm text-stone-600 italic leading-relaxed">{d.experienceNote}</p>
                    </div>

                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Best for</p>
                        <p class="text-stone-600 mt-1 leading-relaxed">{d.bestFor}</p>
                      </div>
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Eat this</p>
                        <p class="text-stone-600 mt-1 leading-relaxed">
                          {d.namedFoods.map((f) => f.name).join(", ")}
                        </p>
                      </div>
                    </div>

                    <details class="mt-4 pt-4 border-t border-stone-200 group">
                      <summary class="cursor-pointer flex items-center justify-between text-sm font-semibold text-brand-700 list-none">
                        Climate, transport, stay &amp; a day plan
                        <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
                      </summary>
                      <div class="mt-4 space-y-4">
                        <div>
                          <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Climate</p>
                          <p class="text-sm text-stone-600 mt-1 leading-relaxed">{d.climate}</p>
                        </div>
                        <div>
                          <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">How to get there</p>
                          <p class="text-sm text-stone-600 mt-1 leading-relaxed">{d.transport.howToGet}</p>
                          <p class="text-sm text-stone-600 mt-1 leading-relaxed"><span class="font-medium text-stone-800">Train:</span> {d.transport.byTrain}</p>
                          <p class="text-sm text-stone-600 mt-1 leading-relaxed"><span class="font-medium text-stone-800">Flight:</span> {d.transport.byFlight}</p>
                        </div>
                        <div>
                          <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Where to stay</p>
                          {d.accommodation.map((a) => (
                            <p class="text-sm text-stone-600 mt-1.5 leading-relaxed"><span class="font-medium text-stone-800">{a.type}</span> ({a.priceRange}) - {a.detail}</p>
                          ))}
                        </div>
                        <div>
                          <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Know before you go</p>
                          {d.localWarnings.map((w) => (
                            <p class="text-sm text-stone-600 mt-1.5 leading-relaxed"><span class="font-medium text-stone-800">{w.title}:</span> {w.detail}</p>
                          ))}
                        </div>
                        {d.dayPlans.map((dp) => (
                          <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">A sample {dp.label.toLowerCase()}</p>
                            <ul class="mt-1.5 space-y-1">
                              {dp.steps.map((s) => (
                                <li class="text-sm text-stone-600 flex gap-2 leading-relaxed"><span class="text-brand-600 mt-0.5">-</span>{s}</li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </details>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

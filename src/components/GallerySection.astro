---
const photos = [
  { src: "/images/wuhan-yangtze.webp", alt: "The Wuhan Yangtze River Bridge over the Yangtze", caption: "Wuhan bridge" },
  { src: "/images/extra/yellow-crane-tower.webp", alt: "The Yellow Crane Tower in Wuhan", caption: "Yellow Crane Tower" },
  { src: "/images/wudang-palace.webp", alt: "The Golden Hall at the summit of Wudang Mountain", caption: "Wudang Golden Hall" },
  { src: "/images/extra/wudang-mountain.webp", alt: "Taoist peaks of the Wudang Mountains", caption: "Wudang Mountain" },
  { src: "/images/shennongjia-forest.webp", alt: "Virgin forest in the Shennongjia reserve", caption: "Shennongjia" },
  { src: "/images/three-gorges-dam.webp", alt: "The Three Gorges Dam on the Yangtze", caption: "Three Gorges Dam" },
  { src: "/images/extra/xiling-gorge.webp", alt: "Xiling Gorge downstream of the Three Gorges Dam", caption: "Xiling Gorge" },
  { src: "/images/enshi-canyon.webp", alt: "Limestone cliffs of the Enshi Grand Canyon", caption: "Enshi Grand Canyon" },
  { src: "/images/jingzhou-wall.webp", alt: "The Ming city wall gate of Jingzhou", caption: "Jingzhou wall" },
  { src: "/images/xiangyang-wall.webp", alt: "Panorama of Xiangyang on the Han River", caption: "Xiangyang" },
  { src: "/images/chibi-river.webp", alt: "The Three Kingdoms Red Cliffs scenic area near Chibi", caption: "Chibi" },
  { src: "/images/east-lake-wuhan.webp", alt: "Mount Mo and East Lake in Wuhan", caption: "East Lake" },
  { src: "/images/extra/wuhan-cherry.webp", alt: "Cherry blossom avenue at Wuhan University", caption: "Cherry blossoms" },
  { src: "/images/extra/hubei-museum.webp", alt: "The Hubei Provincial Museum in Wuhan", caption: "Hubei Museum" },
  { src: "/images/extra/hubu-lane.webp", alt: "The food stalls of Hubu Lane in Wuhan", caption: "Hubu Lane" },
  { src: "/images/food/re-gan-mian.webp", alt: "Hot dry noodles, the breakfast icon of Wuhan", caption: "Hot dry noodles" },
];
---
<section id="gallery" class="py-20 md:py-28 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        Hubei in sixteen frames
      </h2>
      <p class="text-stone-500 text-lg mt-4 leading-relaxed max-w-2xl">
        Real photographs — Taoist peaks, forest, the Yangtze and walled cities. All from Wikimedia Commons, credited below.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {photos.map((p) => (
        <figure class="group relative overflow-hidden rounded-xl aspect-[4/5]">
          <img src={p.src} alt={p.alt} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-stone-950/90 to-transparent px-4 pt-10 pb-3 text-white text-xs font-medium">
            {p.caption}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

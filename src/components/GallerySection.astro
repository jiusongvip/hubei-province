---
const photos = [
  { src: "/images/wuhan-yangtze.webp", alt: "The Yangtze River and the Yellow Crane Tower in Wuhan", caption: "Wuhan" },
  { src: "/images/wudang-palace.webp", alt: "Taoist temple halls at Wudang Mountains", caption: "Wudang Mountains" },
  { src: "/images/shennongjia-forest.webp", alt: "Misty primeval forest at Shennongjia", caption: "Shennongjia" },
  { src: "/images/three-gorges-dam.webp", alt: "The Three Gorges Dam on the Yangtze", caption: "Three Gorges Dam" },
  { src: "/images/enshi-canyon.webp", alt: "Limestone cliffs of the Enshi Grand Canyon", caption: "Enshi Grand Canyon" },
  { src: "/images/jingzhou-wall.webp", alt: "The Ming city wall of Jingzhou", caption: "Jingzhou wall" },
  { src: "/images/xiangyang-wall.webp", alt: "The Han River city wall at Xiangyang", caption: "Xiangyang" },
  { src: "/images/chibi-river.webp", alt: "The Yangtze at the Red Cliffs near Chibi", caption: "Chibi" },
];
---
<section id="gallery" class="py-20 md:py-28 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-stone-900 pb-1">
        Hubei in eight frames
      </h2>
      <p class="text-stone-500 text-lg mt-4 leading-relaxed max-w-2xl">
        Taoist peaks, a primeval forest, the Yangtze and the walled cities — the four worlds that make this province feel like several trips in one.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {photos.map((p) => (
        <figure class="group relative overflow-hidden rounded-xl aspect-[4/5]">
          <img src={p.src} alt={p.alt} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-stone-950/90 to-transparent px-4 pt-10 pb-3 text-white text-xs font-medium">
            {p.caption}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

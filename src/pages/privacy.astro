---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Hubei Province Travel Guide | Privacy Policy"
  description="How the Hubei Province Travel Guide handles data: a static site with no accounts, aggregate Google Analytics measurement, and contact email used only to reply."
  noindex={true}
>
  <Nav solid />
  <main class="pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-stone-900 pb-1">Privacy Policy</h1>
      <div class="mt-8 space-y-5 text-stone-600 leading-relaxed">
        <p>
          This site is a static travel guide. We do not run accounts, collect personal data, or require registration.
        </p>
        <h2 class="text-xl font-bold text-stone-900 mt-8">Analytics</h2>
        <p>
          This site uses Google Analytics 4 to measure aggregate traffic (page views, country and device type) so we know which parts of the guide are useful.
          Google processes this data under its own terms; you can read how they handle information at
          <a
            href="https://www.google.com/policies/privacy/"
            rel="noopener"
            class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-800">Google's Privacy Policy</a>.
          We do not receive, store or sell any personal information about you.
        </p>
        <h2 class="text-xl font-bold text-stone-900 mt-8">Email</h2>
        <p>
          If you contact us by email, we use your address only to reply to your message. We do not add it to any list.
        </p>
        <h2 class="text-xl font-bold text-stone-900 mt-8">External links and media</h2>
        <p>
          This site links to external resources such as UNESCO, Wikimedia Commons, China Railway 12306 and government pages.
          Photographs are hosted from our own domain and credited to Wikimedia Commons in the footer.
          We are not responsible for the privacy practices of linked websites.
        </p>
        <h2 class="text-xl font-bold text-stone-900 mt-8">Changes</h2>
        <p>
          If this policy changes, we update this page and the date below. Last updated: August 2026.
        </p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
